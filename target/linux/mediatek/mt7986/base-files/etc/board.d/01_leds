#!/bin/sh

. /lib/functions.sh
. /lib/functions/leds.sh
. /lib/functions/uci-defaults.sh

board=$(board_name)

board_config_update

case $board in
xiaomi,redmi-router-ax6000*)
	ucidef_set_led_default "status" "status" "rgb:status" "1"
	ucidef_set_led_netdev "wan" "wan" "rgb:network" "wan"
	;;
netcore,n60pro-512rom |\
netcore,n60pro)
	ucidef_set_led_default "power" "power" "blue:status" "1"
	ucidef_set_led_netdev "wan" "wan" "blue:wan" "eth1"
	ucidef_set_led_netdev "wlan" "wlan" "blue:wlan" "rax0"
	ucidef_set_led_netdev "usb" "usb" "blue:usb" "usb0"
        ucidef_set_led_netdev "2.5GLAN" "2.5GLAN" "blue:mesh" "lan0"
esac

board_config_flush

exit 0
